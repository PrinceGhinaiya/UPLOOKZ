# =============================================================
# UPLOOKZ Authentication & Notification Configuration
# =============================================================
# Copy this file to .env to configure real Email and Google credentials.
#
# cp .env.example .env
# =============================================================

# -------------------------------------------------------------
# 1. Google OAuth Sign-In (Optional for local dev, Required for production)
# -------------------------------------------------------------
# Create an OAuth 2.0 Web Client ID in the Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Add your local or production origin to "Authorized JavaScript origins":
# e.g. http://localhost:5173
# -------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=676363812508-kgvjhas21ffa5kimsmtsvln4clcj5nmk.apps.googleusercontent.com

# -------------------------------------------------------------
# 2. Email Delivery (SMTP / Gmail / Brevo / Resend)
# -------------------------------------------------------------
# If configured, UPLOOKZ will deliver real 6-digit verification codes
# directly to the user's email inbox via SMTP.
#
# Option A: Gmail SMTP (Use a 16-character Google App Password)
# GMAIL_USER=ghinaiyaprince12@gmail.com
# GMAIL_APP_PASS=psnh zehb nnrf saal#
# Option B: Standard SMTP Gateway (Brevo, SendGrid, Amazon SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM="UPLOOKZ" <noreply@uplookz.com>

# -------------------------------------------------------------
# 3. Development Mode Behavior (Default)
# -------------------------------------------------------------
# When SMTP is not configured:
# UPLOOKZ operates in DevLogger mode:
# - Generates cryptographically secure 6-digit codes.
# - Prints the code clearly to the server terminal.
# - Provides a 1-click Auto-Fill & Verify helper in the modal.
# Testing is never blocked!
# -------------------------------------------------------------
