# UPLOOKZ Authentication & SMS Provider Configuration
# Copy this file to .env and fill in your preferred SMS gateway credentials.

# -------------------------------------------------------------
# Option 1: Fast2SMS (Recommended for India - Quick OTP / DLT)
# Sign up at: https://www.fast2sms.com
# -------------------------------------------------------------
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# -------------------------------------------------------------
# Option 2: Twilio (Global SMS Delivery)
# Sign up at: https://www.twilio.com
# -------------------------------------------------------------
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# -------------------------------------------------------------
# Option 3: MSG91 (India Transactional & OTP Gateway)
# Sign up at: https://msg91.com
# -------------------------------------------------------------
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ID=your_msg91_template_id

# -------------------------------------------------------------
# Development & Testing Mode (Default):
# If none of the above are set, UPLOOKZ automatically runs in 
# DevLogger mode. OTP codes are generated with cryptographically 
# secure random numbers and logged directly to the server terminal.
# OTP codes are NEVER exposed in client responses or public logs.
# -------------------------------------------------------------
